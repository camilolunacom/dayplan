# dayplan configuration.
# Copy to ~/.config/dayplan/env (chmod 600). Real environment variables win over this file.

# --- TickTick -----------------------------------------------------------
# Optional: if unset, dayplan reuses the token already stored by the
# ticktick-cli at ~/.config/ticktick-cli/config.json.
# Mint one with: ticktick auth login
#TICKTICK_TOKEN=

# The TickTick Open API does not expose the Inbox in its project list.
# If you want Inbox tasks, find the inbox project id (it looks like
# inbox123456789, visible in the web app URL) and add it here.
#TICKTICK_EXTRA_PROJECT_IDS=

# --- Asana --------------------------------------------------------------
# Personal Access Token from https://app.asana.com/0/my-apps
ASANA_TOKEN=
# Optional: restrict to specific workspace gids (comma separated).
# your-org.example = <workspace-gid>
#ASANA_WORKSPACES=<workspace-gid>

# --- Jira ---------------------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Optional: override the default JQL.
#JIRA_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY due ASC

# --- Storage ------------------------------------------------------------
#DAYPLAN_DB=~/.local/share/dayplan/dayplan.sqlite
