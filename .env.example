# dayplan configuration.
# Copy to ~/.config/dayplan/env (chmod 600). Real environment variables win over this file.

# --- TickTick -----------------------------------------------------------
# Optional: if unset, dayplan reuses the token already stored by the
# ticktick-cli at ~/.config/ticktick-cli/config.json.
# Mint one with: ticktick auth login
#TICKTICK_TOKEN=

# Only pull tasks due within N days of today. 0 = today and anything overdue,
# 7 = the rest of the week. Unset = no date filter at all.
#TICKTICK_DUE_WITHIN_DAYS=0
# Undated tasks are kept by default: an undated task is not future clutter.
#TICKTICK_INCLUDE_UNDATED=true

# The TickTick Open API does not expose the Inbox in its project list.
# If you want Inbox tasks, find the inbox project id (it looks like
# inbox123456789, visible in the web app URL) and add it here.
#TICKTICK_EXTRA_PROJECT_IDS=

# --- Asana --------------------------------------------------------------
# Personal Access Token from https://app.asana.com/0/my-apps
ASANA_TOKEN=
# Optional: restrict to specific workspace gids (comma separated).
# Find gids with: curl -H "Authorization: Bearer $ASANA_TOKEN" \
#   https://app.asana.com/api/1.0/users/me?opt_fields=workspaces.gid,workspaces.name
#ASANA_WORKSPACES=

# Optional: narrow Asana to specific project gids. When set, ASANA_WORKSPACES
# is ignored and *only* these projects are pulled. The gid is the long number
# in the board URL: app.asana.com/1/<workspace>/project/<PROJECT_GID>/board/...
#ASANA_PROJECTS=

# Optional: within those projects, keep only these board columns (sections),
# matched case-insensitively by name.
#ASANA_SECTIONS=New Requests,In Progress

# Keep only tasks assigned to the token owner. Default true.
#ASANA_ONLY_MINE=true

# Also pull the open subtasks of every matching task. Subtasks are not project
# members, so no section filter applies to them; they come in because their
# parent matched. Subtasks assigned to someone else are skipped, unassigned
# ones are kept. Default true.
#ASANA_INCLUDE_SUBTASKS=true

# --- Jira ---------------------------------------------------------------
# Token from https://id.atlassian.com/manage-profile/security/api-tokens
# Both kinds work; they differ only in the base URL.
#
#   Token WITHOUT scopes -> the site URL (simplest):
JIRA_BASE_URL=https://your-site.atlassian.net
#
#   Token WITH scopes -> the gateway, and grant read:jira-work + read:jira-user.
#   dayplan never writes, so a read-only scoped token is the safer choice.
#JIRA_BASE_URL=https://api.atlassian.com/ex/jira/<your-cloud-id>
#   Optional: only needed if /serverInfo cannot be reached to build issue links.
#JIRA_SITE_URL=https://your-site.atlassian.net

JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Optional: override the default JQL.
#JIRA_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY due ASC

# --- Storage ------------------------------------------------------------
#DAYPLAN_DB=~/.local/share/dayplan/dayplan.sqlite
